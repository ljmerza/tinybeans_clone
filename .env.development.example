# Local development settings loaded by docker-compose.yml via `env_file:`.
#
#   cp .env.development.example .env.development
#
# Only settings that docker-compose.yml does NOT already set belong here. Anything in the
# compose `environment:` block (Django security flags, Postgres/Redis/Celery, MinIO, URLs,
# Google OAuth, ...) overrides this file, so put overrides for those in `.env` instead --
# see "Serving the Stack on Your Own Domain" in DEVELOPMENT.md.

# 2FA
TWOFA_ENABLED=1
# Must be a Fernet key. With DEBUG on, an unset/invalid key falls back to one derived from
# SECRET_KEY. Generate a real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TWOFA_ENCRYPTION_KEY=
TWOFA_LOCKOUT_DURATION_MINUTES=30
TWOFA_LOCKOUT_THRESHOLD=5
TWOFA_TRUSTED_DEVICE_ENABLED=1
TWOFA_TRUSTED_DEVICE_MAX_AGE_DAYS=30
TWOFA_TRUSTED_DEVICE_MAX_COUNT=5
TWOFA_ISSUER_NAME=Circles (Dev)

# Circle invitations (defaults shown; see DEVELOPMENT.md → Circle Invitation Configuration)
# CIRCLE_INVITE_RATELIMIT=10/15m
# CIRCLE_INVITE_RESEND_RATELIMIT=5/15m
# CIRCLE_INVITE_CIRCLE_LIMIT=25
# CIRCLE_INVITE_CIRCLE_LIMIT_WINDOW_MINUTES=60
# CIRCLE_INVITE_REMINDER_DELAY_MINUTES=1440
# CIRCLE_INVITE_REMINDER_COOLDOWN_MINUTES=1440
# CIRCLE_INVITE_REMINDER_BATCH_SIZE=100
# CIRCLE_INVITE_ONBOARDING_TTL_MINUTES=60

# Client IP behind proxies (rate limits, throttles, audit IPs). With DEBUG on, the defaults
# trust X-Forwarded-For as-is. Production: DJANGO_TRUST_FORWARDED_FOR=1 and
# DJANGO_TRUSTED_PROXY_IPS=127.0.0.1,::1 (addresses or CIDR ranges); see
# _docs/guides/security/env_reference.md.
# DJANGO_TRUST_FORWARDED_FOR=1
# DJANGO_TRUSTED_PROXY_IPS=127.0.0.1,::1
